<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>이민호의 iPhone</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro KR", "SF Pro Text", "Helvetica Neue", sans-serif;
        }

        body {
            background-color: #222;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            overflow: hidden;
        }

        /* 아이폰 외형 프레임 */
        .iphone-frame {
            width: 390px;
            height: 844px;
            background-color: #000;
            border-radius: 50px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
            position: relative;
            overflow: hidden;
            border: 10px solid #444;
        }

        /* 아이폰 화면 내부 */
        .screen {
            width: 100%;
            height: 100%;
            position: relative;
            overflow: hidden;
            background-size: cover;
            background-position: center;
        }

        /* 상단 상태바 */
        .status-bar {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 44px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 25px;
            color: white;
            font-size: 13px;
            font-weight: 600;
            z-index: 100;
        }

        /* 공통 화면 스타일 */
        .page {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 50px 20px 30px 20px;
            transition: opacity 0.4s ease, transform 0.4s ease;
        }

        .hidden {
            opacity: 0;
            pointer-events: none;
            transform: scale(1.05);
        }

        /* 1. 잠금화면 */
        #lock-screen {
            background-image: linear-gradient(rgba(0,0,0,0.2), rgba(0,0,0,0.4)), url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80');
            color: white;
            align-items: center;
            cursor: pointer;
        }

        .lock-time {
            font-size: 80px;
            font-weight: 300;
            margin-top: 40px;
        }

        .lock-date {
            font-size: 18px;
            font-weight: 500;
        }

        .lock-notice {
            font-size: 14px;
            opacity: 0.8;
            margin-bottom: 20px;
            animation: bounce 1.5s infinite;
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-5px); }
        }

        /* 2. 비밀번호 입력 화면 */
        #passcode-screen {
            background-color: rgba(20, 20, 20, 0.85);
            backdrop-filter: blur(20px);
            color: white;
            align-items: center;
            justify-content: center;
            z-index: 10;
        }

        .passcode-title {
            font-size: 18px;
            margin-bottom: 20px;
            font-weight: 400;
        }

        .passcode-dots {
            display: flex;
            gap: 15px;
            margin-bottom: 50px;
        }

        .dot {
            width: 14px;
            height: 14px;
            border: 1px solid white;
            border-radius: 50%;
            transition: background-color 0.2s;
        }

        .dot.filled {
            background-color: white;
        }

        .keypad {
            display: grid;
            grid-template-columns: repeat(3, 75px);
            gap: 20px;
        }

        .key {
            width: 75px;
            height: 75px;
            background-color: rgba(255, 255, 255, 0.15);
            border-radius: 50%;
            border: none;
            color: white;
            font-size: 28px;
            font-weight: 400;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: background-color 0.2s;
        }

        .key:active {
            background-color: rgba(255, 255, 255, 0.4);
        }

        .key span {
            font-size: 10px;
            letter-spacing: 2px;
            margin-top: -2px;
            opacity: 0.7;
        }

        /* 3. 홈 화면 */
        #home-screen {
            background-image: url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80');
            padding-top: 60px;
        }

        .app-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px 15px;
        }

        .app-icon {
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            transition: transform 0.1s;
        }

        .app-icon:active {
            transform: scale(0.92);
        }

        .icon-img {
            width: 60px;
            height: 60px;
            border-radius: 14px;
            background-color: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 26px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }

        .icon-name {
            color: white;
            font-size: 11px;
            margin-top: 6px;
            text-shadow: 0 1px 3px rgba(0,0,0,0.8);
        }

        /* 4. 앱 실행 모달 창 */
        #app-modal {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: white;
            z-index: 20;
            display: flex;
            flex-direction: column;
            padding: 50px 20px 20px 20px;
            transform: translateY(100%);
            transition: transform 0.4s cubic-bezier(0.1, 0.9, 0.2, 1);
        }

        #app-modal.active {
            transform: translateY(0);
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            border-bottom: 1px solid #eee;
            padding-bottom: 10px;
        }

        .close-btn {
            background: #007aff;
            color: white;
            border: none;
            padding: 6px 14px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 13px;
        }

        .modal-body {
            font-size: 15px;
            color: #333;
            line-height: 1.5;
        }

        /* 하단 홈 바 */
        .home-bar {
            width: 130px;
            height: 5px;
            background-color: rgba(255, 255, 255, 0.7);
            border-radius: 10px;
            position: absolute;
            bottom: 10px;
            left: 50%;
            transform: translateX(-50%);
            cursor: pointer;
        }
    </style>
</head>
<body>

    <div class="iphone-frame">
        <div class="screen">
            
            <!-- 상단 상태바 (고정 시간: 00:00) -->
            <div class="status-bar">
                <span>00:00</span>
                <span>📶 🛜 🔋</span>
            </div>

            <!-- 1. 잠금 화면 -->
            <div id="lock-screen" class="page" onclick="showPasscodeScreen()">
                <div style="text-align: center;">
                    <div class="lock-date">10월 25일 일요일</div>
                    <div class="lock-time">00:00</div>
                </div>
                <div style="text-align: center;" class="lock-notice">화면을 터치하여 잠금 해제</div>
            </div>

            <!-- 2. 비밀번호 입력 화면 (정답: 0922) -->
            <div id="passcode-screen" class="page hidden">
                <div style="display: flex; flex-direction: column; align-items: center; width: 100%;">
                    <div class="passcode-title">암호 입력 (힌트: 0922)</div>
                    <div class="passcode-dots">
                        <div class="dot" id="dot-0"></div>
                        <div class="dot" id="dot-1"></div>
                        <div class="dot" id="dot-2"></div>
                        <div class="dot" id="dot-3"></div>
                    </div>
                    <div class="keypad">
                        <button class="key" onclick="pressKey(1)">1</button>
                        <button class="key" onclick="pressKey(2)">2</button>
                        <button class="key" onclick="pressKey(3)">3</button>
                        <button class="key" onclick="pressKey(4)">4</button>
                        <button class="key" onclick="pressKey(5)">5</button>
                        <button class="key" onclick="pressKey(6)">6</button>
                        <button class="key" onclick="pressKey(7)">7</button>
                        <button class="key" onclick="pressKey(8)">8</button>
                        <button class="key" onclick="pressKey(9)">9</button>
                        <button class="key" style="background: transparent; border: none;"></button>
                        <button class="key" onclick="pressKey(0)">0</button>
                        <button class="key" style="background: transparent; border: none; font-size: 14px;" onclick="resetPasscode()">지우기</button>
                    </div>
                </div>
            </div>

            <!-- 3. 홈 화면 (요청하신 8개 앱 아이콘) -->
            <div id="home-screen" class="page hidden">
                <div class="app-grid">
                    <div class="app-icon" onclick="openApp('Instagram', '📸 이민호님의 피드\n\n오늘도 평화로운 하루. 생일 축하해주셔서 감사합니다! 🤍')">
                        <div class="icon-img" style="background: linear-gradient(135deg, #f58529, #dd2a7b, #8134af);">📸</div>
                        <div class="icon-name">Instagram</div>
                    </div>
                    <div class="app-icon" onclick="openApp('카카오톡', '💬 [채팅 목록]\n\n• 개💛 (고정): 형 생일축하해🤍 (00:00)\n• 박민섭: ㅅㅊㅅㅊ\n• 김준호: 조만간 얼굴 한 번 보자\n• 올리브영: [생일쿠폰] 3천원 할인쿠폰 지급\n• 조유정: 오늘 뭐 하세요?\n• 대한항공: 오클랜드행 예약 확정\n• 롯데택배: 상품이 문앞에 도착했습니다')">
                        <div class="icon-img" style="background-color: #fee500; color: #381e1f;">💬</div>
                        <div class="icon-name">카카오톡</div>
                    </div>
                    <div class="app-icon" onclick="openApp('앨범', '🖼️ [사진 갤러리]\n\n시간순으로 정렬된 추억의 사진들과 즐겨찾기(Favorite) 기능이 포함될 공간입니다.')">
                        <div class="icon-img" style="background: linear-gradient(135deg, #34c759, #30b0c7);">🖼️</div>
                        <div class="icon-name">앨범</div>
                    </div>
                    <div class="app-icon" onclick="openApp('카메라', '📷 [카메라 앱]\n\n찰칵! 사진을 촬영하거나 둘러볼 수 있는 공간입니다.')">
                        <div class="icon-img" style="background-color: #e5e5ea; color: #000;">📷</div>
                        <div class="icon-name">카메라</div>
                    </div>
                    <div class="app-icon" onclick="openApp('전화', '📞 [전화 앱]\n\n최근 통화 기록 및 개💛(김승민)에게 온 부재중 전화 확인')">
                        <div class="icon-img" style="background-color: #34c759;">📞</div>
                        <div class="icon-name">전화</div>
                    </div>
                    <div class="app-icon" onclick="openApp('배달어플', '🛵 [배달어플]\n\n최근 주문 및 김승민 님이 보낸 롯데택배 선물 배송 완료 안내')">
                        <div class="icon-img" style="background-color: #ff3b30;">🛵</div>
                        <div class="icon-name">배달어플</div>
                    </div>
                    <div class="app-icon" onclick="openApp('캘린더', '📅 [캘린더]\n\n• 10월 25일: 이민호 생일 🎉\n• 10월 27일 22:50: 오클랜드행 항공권 출국')">
                        <div class="icon-img" style="background-color: #fff; color: #ff3b30;">📅</div>
                        <div class="icon-name">캘린더</div>
                    </div>
                    <div class="app-icon" onclick="openApp('Safari', '🧭 [Safari 방문 기록]\n\n- 대한항공 예약 조회\n- 올리브영 온라인몰')">
                        <div class="icon-img" style="background: linear-gradient(135deg, #007aff, #5ac8fa);">🧭</div>
                        <div class="icon-name">Safari</div>
                    </div>
                </div>
                <div class="home-bar" onclick="goHome()"></div>
            </div>

            <!-- 4. 앱 실행 모달 창 -->
            <div id="app-modal">
                <div class="modal-header">
                    <h3 id="modal-title">앱 제목</h3>
                    <button class="close-btn" onclick="closeApp()">닫기</button>
                </div>
                <div class="modal-body" id="modal-content" style="white-space: pre-line;">
                    앱 내용이 들어갑니다.
                </div>
            </div>

        </div>
    </div>

    <script>
        let currentPin = "";

        // 잠금화면 -> 비밀번호 화면으로 전환
        function showPasscodeScreen() {
            document.getElementById('lock-screen').classList.add('hidden');
            document.getElementById('passcode-screen').classList.remove('hidden');
        }

        // 키패드 입력 처리 (정답: 0922)
        function pressKey(num) {
            if (currentPin.length < 4) {
                currentPin += num;
                updateDots();
            }

            // 4자리가 채워지면 비밀번호 검증
            if (currentPin.length === 4) {
                if (currentPin === "0922") {
                    setTimeout(() => {
                        document.getElementById('passcode-screen').classList.add('hidden');
                        document.getElementById('home-screen').classList.remove('hidden');
                        currentPin = "";
                        updateDots();
                    }, 200);
                } else {
                    setTimeout(() => {
                        alert("비밀번호가 틀렸습니다. (힌트: 0922)");
                        resetPasscode();
                    }, 100);
                }
            }
        }

        // 비밀번호 점 동기화
        function updateDots() {
            for (let i = 0; i < 4; i++) {
                const dot = document.getElementById(`dot-${i}`);
                if (i < currentPin.length) {
                    dot.classList.add('filled');
                } else {
                    dot.classList.remove('filled');
                }
            }
        }

        // 비밀번호 초기화
        function resetPasscode() {
            currentPin = "";
            updateDots();
        }

        // 앱 열기
        function openApp(title, content) {
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-content').innerText = content;
            document.getElementById('app-modal').classList.add('active');
        }

        // 앱 닫기
        function closeApp() {
            document.getElementById('app-modal').classList.remove('active');
        }

        // 홈으로 가기 (하단 바 터치 시)
        function goHome() {
            closeApp();
        }
    </script>

</body>
</html>
